# PyFinAgent 配置模板。复制为 .env 后填入你自己的值（.env 已被 .gitignore，切勿提交）。
# 说明：留空的外部依赖会自动进入 mock/降级模式。docker-compose 运行时，app 服务会用
# 服务名覆盖下面几个 DSN（见 docker-compose.yml 的 app.environment），此处填的是【本机直跑】用的值。

# ---- 大模型（任选一家 OpenAI 兼容协议的服务；三个变量一起改）----
# 想更快出字就选轻量快模型：qwen-turbo / deepseek-chat 明显快于 qwen-plus/qwen-max。
# 方案A（默认，推荐求快）通义千问 Qwen（阿里云百炼/DashScope，兼容模式，支持流式）：
#   OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen-turbo          # 最快；要更强可换 qwen-plus / qwen-max（更慢）
# 方案B DeepSeek：
#   OPENAI_BASE_URL=https://api.deepseek.com/v1   LLM_MODEL=deepseek-chat
OPENAI_API_KEY=            # 你的大模型 key（留空则 mock 回显，不产生真实回答）
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-turbo
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_RATE_PER_SEC=8

# ---- 数据库 / 缓存（本机直跑用 localhost；docker-compose 里会被覆盖成服务名） ----
MYSQL_DSN=mysql+aiomysql://pyfin:pyfin@localhost:3307/pyfinagent
REDIS_URL=redis://localhost:6379/0

# ---- 联网取数 / 研究 ----
ENABLE_LIVE_DATA=true              # true 时产品查询走真实数据(akshare)
LIVE_DATA_REFRESH_SEC=600          # 后台每隔多少秒预热刷新基金排行缓存(用户查询直接命中，不等慢拉取)
SAMPLE_FALLBACK=false              # false=真实数据取不到就如实说"查不到"(推荐)；true=回退内置示例数据兜底
WEB_SEARCH_API_KEY=                # Tavily key，配了才能联网搜索/爬网页
WEB_SEARCH_URL=https://api.tavily.com/search

# ---- 鉴权（给别人用之前务必开启） ----
AUTH_ENABLED=false                 # 上线设 true
# ⚠️ 上线务必换成强随机值（≥16位）；开启鉴权且仍为占位/过短值时应用会拒绝启动。
# 生成办法：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-please-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# 登录仅走真实用户表（注册后使用），已无演示账号。

# ---- 限流 / 成本控制（保护大模型额度；给别人用之前建议按需调小；0=不限）----
RATE_LIMIT_PER_MIN=15      # 每用户每分钟提问上限
RATE_LIMIT_PER_DAY=300     # 每用户每日提问上限

# ---- 响应速度（默认已按"更快"配置）----
# false=关键词判不出意图的模糊问题直接走知识问答(更快，少一次分类大模型往返)；true=用大模型精确分类(更准但更慢)
ROUTER_LLM_FALLBACK=false
REACT_MAX_STEPS=3          # 产品/研究类最多调几次工具（越小越快、信息可能略少；建议 2-4）

# ---- 服务 ----
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
